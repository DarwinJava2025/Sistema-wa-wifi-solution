# =============================================================================
# OpenWA - Plantilla de despliegue para frontend-server
# =============================================================================
# Uso en el servidor:
#   cp .env.deploy.example .env
#   nano .env               # rellena las contraseñas/keys marcadas CHANGE_ME
#   docker compose up -d    # levanta docker-proxy + openwa-api (sin --profile:
#                            # se usan el Postgres/Redis externos ya existentes)
#
# .env está en .gitignore: nunca se sube al repo. Este archivo (.env.deploy.example) SÍ se
# sube, por eso no lleva secretos reales — solo placeholders CHANGE_ME.
#
# Requiere docker-compose.override.yml (en este mismo repo) para que openwa-api pueda
# resolver host.docker.internal y así alcanzar los contenedores bancaribe_db / bancaribe_redis
# que ya corren en este host.

# =============================================================================
# CORE
# =============================================================================
NODE_ENV=production
LOG_LEVEL=info

# Puerto publicado en el HOST (127.0.0.1:2785 según docker-compose.yml). El puerto interno del
# contenedor siempre es 2785 y no se cambia desde aquí.
API_PORT=2785

# Reinicia automáticamente, al arrancar el contenedor, las sesiones de WhatsApp que ya estaban
# autenticadas antes del reinicio.
AUTO_START_SESSIONS=true

# Límites del contenedor (docker-compose los lee como mem_limit/pids_limit)
OPENWA_MEM_LIMIT=2g
OPENWA_PIDS_LIMIT=2048

# =============================================================================
# BASE DE DATOS — Postgres EXTERNO (contenedor bancaribe_db ya existente en este servidor)
# =============================================================================
DATABASE_TYPE=postgres
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5434
DATABASE_NAME=openwa_db
DATABASE_USERNAME=openwa_user
# Contraseña del usuario openwa_user creado en bancaribe_db (CREATE USER ... WITH PASSWORD ...).
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_SCHEMA=public
# false en producción: el esquema se crea/actualiza vía migraciones (TypeORM), no por sync.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# =============================================================================
# REDIS — reutiliza el contenedor bancaribe_redis ya existente en este servidor
# =============================================================================
REDIS_ENABLED=true
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
# Deja vacío si bancaribe_redis no tiene contraseña configurada (requirepass).
REDIS_USERNAME=
REDIS_PASSWORD=
CACHE_ENABLED=true

# =============================================================================
# STORAGE (media de WhatsApp) — filesystem local del volumen openwa-data
# =============================================================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# =============================================================================
# SEGURIDAD
# =============================================================================
# Genera cada valor con: openssl rand -hex 32
API_MASTER_KEY=CHANGE_ME_RUN_openssl_rand_-hex_32
API_KEY_PEPPER=CHANGE_ME_RUN_openssl_rand_-hex_32

# Orígenes permitidos para el dashboard (CORS). Ajusta al dominio real si se expone con reverse
# proxy; vacío = ninguno permitido en producción (más restrictivo, ajustar según necesidad).
CORS_ORIGINS=

# Deja "false" si el dashboard se sirve por HTTP plano detrás de un proxy sin TLS propio; si
# pones un reverse proxy con HTTPS delante, se puede dejar el valor por defecto (comentado).
# CSP_UPGRADE_INSECURE_REQUESTS=false
