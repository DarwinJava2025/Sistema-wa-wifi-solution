# =============================================================================
# OpenWA - Plantilla de despliegue para docker-container-server (10.123.123.3)
# =============================================================================
# OpenWA corre en su propio servidor, con su propio Postgres y Redis (los contenedores
# openwa-postgres / openwa-redis de este docker-compose.yml, perfiles "postgres" y "redis").
# El bff de fiber-optics-portal corre en OTRO servidor (192.168.90.88) y llama a esta API por la
# red; OpenWA, a su vez, le manda los mensajes entrantes al bff por webhook.
#
# Primera vez, en el servidor:
#   cd /var/opt/sistema-wa-wifi-solution
#   cp .env.deploy.example .env
#   nano .env               # rellena todo lo que dice CHANGE_ME
# Luego, desde tu Mac: ./deploy.sh
#
# .env está en .gitignore: nunca se sube al repo. Este archivo SÍ se sube, por eso solo lleva
# placeholders CHANGE_ME, nunca secretos reales.
# =============================================================================
# =============================================================================
# CORE
# =============================================================================
NODE_ENV=production
LOG_LEVEL=info

# Puerto publicado en el HOST (en la interfaz API_BIND, ver RED más abajo). El puerto interno del
# contenedor siempre es 2785 y no se cambia desde aquí.
API_PORT=2785

# Reinicia automáticamente, al arrancar el contenedor, las sesiones de WhatsApp que ya estaban
# autenticadas antes del reinicio.
AUTO_START_SESSIONS=true

# Límites del contenedor (docker-compose los lee como mem_limit/pids_limit)
OPENWA_MEM_LIMIT=2g
OPENWA_PIDS_LIMIT=2048

# =============================================================================
# BASE DE DATOS y REDIS — propios de OpenWA (contenedores de este mismo docker-compose.yml)
# =============================================================================
# Activa los servicios opcionales openwa-postgres y openwa-redis: `docker compose up -d` los
# levanta junto con la API sin tener que pasar --profile. Quedan solo en la red interna de
# Docker (no publican puertos), así que no chocan con otros Postgres del servidor.
COMPOSE_PROFILES=postgres,redis

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
# Se usa para CREAR la base la primera vez (openwa-postgres) y para conectarse. Genera con:
# openssl rand -hex 24
DATABASE_PASSWORD=CHANGE_ME
POSTGRES_SCHEMA=public
# false en producción: el esquema se crea/actualiza vía migraciones (TypeORM), no por sync.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
CACHE_ENABLED=true

# =============================================================================
# RED — el bff está en otro servidor
# =============================================================================
# Interfaz donde se publica el puerto 2785. La IP del propio servidor deja la API alcanzable desde
# la red interna (el bff en 192.168.90.88). Limita el acceso con el firewall del servidor:
#   sudo ufw allow from 192.168.90.88 to any port 2785 proto tcp
API_BIND=10.123.123.3

# El webhook de mensajes entrantes apunta al bff (BFF_PUBLIC_URL del bff + /api/wifi-bot/...).
# OpenWA bloquea por defecto los webhooks a IPs privadas (protección SSRF): si BFF_PUBLIC_URL es
# una IP o nombre interno, ponlo aquí. Si es un dominio público (https://...), déjalo vacío.
SSRF_ALLOWED_HOSTS=192.168.90.88

# =============================================================================
# STORAGE (media de WhatsApp) — filesystem local del volumen openwa-data
# =============================================================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# =============================================================================
# SEGURIDAD
# =============================================================================
# Genera cada valor con: openssl rand -hex 32
API_MASTER_KEY=CHANGE_ME
API_KEY_PEPPER=CHANGE_ME

# Orígenes permitidos para el dashboard (CORS). Ajusta al dominio real si se expone con reverse
# proxy; vacío = ninguno permitido en producción (más restrictivo, ajustar según necesidad).
CORS_ORIGINS=

# Deja "false" si el dashboard se sirve por HTTP plano detrás de un proxy sin TLS propio; si
# pones un reverse proxy con HTTPS delante, se puede dejar el valor por defecto (comentado).
# CSP_UPGRADE_INSECURE_REQUESTS=false
